{
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "SchedulerAgent/backend/node_modules/.prisma/client/**",
          "SchedulerAgent/backend/node_modules/@prisma/client/**",
          "node_modules/.prisma/client/**",
          "node_modules/@prisma/client/**"
        ]
      }
    },
    {
      "src": "SchedulerAgent/frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "SchedulerAgent/frontend/$1"
    }
  ]
}



