{
  "builds": [
    {
      "src": "SchedulerAgent/backend/src/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "SchedulerAgent/backend/node_modules/.prisma/client/**",
          "SchedulerAgent/backend/node_modules/@prisma/client/**"
        ]
      }
    },
    {
      "src": "SchedulerAgent/frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "functions": {
    "SchedulerAgent/backend/src/index.js": {
      "includeFiles": [
        "SchedulerAgent/backend/node_modules/.prisma/client/**",
        "SchedulerAgent/backend/node_modules/@prisma/client/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "SchedulerAgent/backend/src/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "SchedulerAgent/frontend/$1"
    }
  ]
}

