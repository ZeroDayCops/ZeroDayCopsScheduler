{
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "SchedulerAgent/backend/node_modules/.prisma/client/**",
          "SchedulerAgent/backend/node_modules/@prisma/client/**",
          "node_modules/.prisma/client/**",
          "node_modules/@prisma/client/**"
        ]
      }
    },
    {
      "src": "SchedulerAgent/frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "headers": [
    {
      "source": "/(index\\.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://zerodaycopsscheduler.onrender.com/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "SchedulerAgent/frontend/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api/|assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "dest": "SchedulerAgent/frontend/index.html"
    }
  ]
}
